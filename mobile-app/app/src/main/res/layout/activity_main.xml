<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Scrollable Main Content Container -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/mobileBottomNav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvAppHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ Auto Track"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStepIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1 of 4"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#064E3B"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- ================================================================= -->
            <!-- STEP 1: WELCOME & VALUE PROPOSITION SCREEN -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zero-Manual Financial Intelligence"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatic UPI Expense Tracking for India 🇮🇳"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Track automatically intercepts every payment on GPay, PhonePe, and Paytm, encrypts it on your device, and syncs live to your web dashboard."
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

                <!-- Feature Highlights -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ 100% Auto-Captured Payment Receipt Popups"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔐 Zero-Knowledge AES-256 Client Encryption"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💻 Instant Sub-100ms Mobile-to-Laptop Real-Time Sync"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGoToStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_emerald_button"
                    android:text="Start Mobile Verification (Step 2 ➔)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ================================================================= -->
            <!-- STEP 2: STRICT MOBILE VERIFICATION & VAULT CODE SMS GENERATION -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2: Mobile Verification"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter your mobile number and verify SMS OTP to generate your encrypted Vault Sync Code."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <!-- User Name Input -->
                <EditText
                    android:id="@+id/etUserNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Your Full Name (e.g. Anas)"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <!-- Phone Number Input -->
                <EditText
                    android:id="@+id/etPhoneNumberInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="+91 10-Digit Mobile Number"
                    android:inputType="phone"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1E293B"
                    android:text="Send Verification OTP SMS"
                    android:textColor="#10B981" />

                <!-- OTP Verification Container -->
                <LinearLayout
                    android:id="@+id/layoutOtpSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etOtpInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:hint="Enter 6-Digit OTP (e.g. 894201)"
                        android:inputType="number"
                        android:padding="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#059669"
                        android:text="Verify OTP &amp; Register Vault Code"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Vault Code Card (HIDDEN INITIALLY UNTIL OTP VERIFIED!) -->
                <LinearLayout
                    android:id="@+id/cardVaultCodeDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_vault_card"
                    android:padding="16dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔑 Your Encrypted Device Vault Code"
                        android:textColor="#A7F3D0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvVaultCodeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SP-623440"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="4dp" />

                    <Button
                        android:id="@+id/btnCopyVaultCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#047857"
                        android:text="📋 Copy Vault Code"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGoToStep3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_emerald_button"
                    android:text="Link Bank via Setu AA (Step 3 ➔)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ================================================================= -->
            <!-- STEP 3: SETU ACCOUNT AGGREGATOR (AA) DIGITAL CONSENT LINK -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/layoutStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 3: RBI Account Aggregator (AA) Consent"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grant 1-time RBI Account Aggregator digital consent via Setu AA gateway for zero-failure tracking."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <!-- Bank Selection Chips -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnBankHdfc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_bank_chip"
                        android:text="🏦 HDFC Bank"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnBankSbi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_bank_chip"
                        android:text="🏛️ SBI Bank"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnBankIcici"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_bank_chip"
                        android:text="💳 ICICI Bank"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnBankAxis"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_bank_chip"
                        android:text="🌐 Axis Bank"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </GridLayout>

                <Button
                    android:id="@+id/btnRequestAaConsent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1E293B"
                    android:text="Request Setu AA Digital Consent OTP"
                    android:textColor="#10B981" />

                <!-- Setu AA Consent OTP Container -->
                <LinearLayout
                    android:id="@+id/layoutAaOtpSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etAaOtpInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:hint="Enter Setu AA Consent OTP (e.g. 772200)"
                        android:inputType="number"
                        android:padding="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnConfirmAaConsent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#059669"
                        android:text="Approve RBI AA Digital Consent"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBankStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#064E3B"
                    android:padding="12dp"
                    android:text="⚠️ RBI AA Consent Status: Pending Selection"
                    android:textColor="#A7F3D0"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGoToStep4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_emerald_button"
                    android:text="Configure System Permissions (Step 4 ➔)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ================================================================= -->
            <!-- STEP 4: STRICT REQUIRED SYSTEM PERMISSIONS -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/layoutStep4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 4: Required System Permissions"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You must enable BOTH permissions below to activate the payment interception overlay service."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <!-- Permission 1: Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0F172A"
                    android:padding="14dp"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Display Over Other Apps: PENDING ❌"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGrantOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#1E293B"
                        android:text="Enable Overlay Permission"
                        android:textColor="#10B981" />
                </LinearLayout>

                <!-- Permission 2: Notification Listener -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0F172A"
                    android:padding="14dp"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvNotificationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Notification Listener: PENDING ❌"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGrantNotification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#1E293B"
                        android:text="Enable Notification Listener"
                        android:textColor="#10B981" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnFinishOnboarding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_emerald_button"
                    android:text="Activate Mobile Dashboard 🚀"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ================================================================= -->
            <!-- STEP 5: FULL MOBILE FINANCIAL DASHBOARD WITH 5 TABS -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/layoutDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- DASHBOARD TAB 1: OVERVIEW -->
                <LinearLayout
                    android:id="@+id/dashTabOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Mobile Dashboard Stats Cards -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_glass_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="September Spent"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTotalExpense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0.00"
                                android:textColor="#F43F5E"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_glass_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Monthly Income"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTotalIncome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹85,000"
                                android:textColor="#10B981"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </GridLayout>

                    <!-- Sync Vault Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_vault_card"
                        android:padding="14dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔑 Live Web Vault Sync Code"
                                android:textColor="#A7F3D0"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDashboardVaultCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SP-623440"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnDashCopyVault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#047857"
                            android:text="Copy Code"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Category Spending Analytics -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_glass_card"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 Category Spending Breakdown"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmptyAnalytics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No transactions logged yet. Payments made on GPay/PhonePe will automatically appear here."
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- DASHBOARD TAB 2: LEDGER -->
                <LinearLayout
                    android:id="@+id/dashTabLedger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧾 Transaction Ledger"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvEmptyLedger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:padding="20dp"
                        android:text="No transactions recorded yet. Make a UPI payment on GPay/PhonePe to see auto-intercepted receipts!"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- DASHBOARD TAB 3: BUDGETS -->
                <LinearLayout
                    android:id="@+id/dashTabBudgets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Budget Limits"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:padding="20dp"
                        android:text="Configure monthly spending limits per category. Limits are synced live to your cloud vault!"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- DASHBOARD TAB 4: EMIS -->
                <LinearLayout
                    android:id="@+id/dashTabEmis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💳 EMI &amp; Loan Tracker"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:padding="20dp"
                        android:text="Track active monthly EMIs and loan payoff schedules with automatic payment reminders."
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- DASHBOARD TAB 5: SETTINGS -->
                <LinearLayout
                    android:id="@+id/dashTabSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Mobile Settings &amp; Permissions"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnResetOnboarding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#1E293B"
                        android:text="🔄 Re-run Setup Wizard &amp; Permissions"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar (Visible ONLY on Step 5 Dashboard) -->
    <LinearLayout
        android:id="@+id/mobileBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#0F172A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/navTabOverview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Overview"
            android:textColor="#10B981"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navTabLedger"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Ledger"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navTabBudgets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Budgets"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navTabEmis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="EMIs"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Settings"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

</RelativeLayout>
